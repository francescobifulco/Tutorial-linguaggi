{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Raylib Project",
            "command": "g++",
            "args": [
                "-g",
                "${fileDirname}\\*.c++",
                "${fileDirname}\\*.cpp",
                "-o",
                "${fileDirname}\\Tetris.exe",
                "-I",
                "C:/raylib/include",
                "-L",
                "C:/raylib/lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}